#!/usr/bin/env bash
#
# Tear down the route server infrastructure created by
# aws-create-route-servers.
#
# Route server endpoints bill hourly and are VPC resources, not
# cluster ones, so they outlive the cluster that prompted them. A QE
# cluster reaped after twelve hours leaves them behind, and its VPC
# cannot be deleted while they are attached. Hence this.
#
#   aws-delete-route-servers --dry-run
#
# Normally it identifies what to delete from the running cluster.
# Once the cluster is gone there is nothing to ask, so name it:
#
#   INFRA=mycluster-abcde AWS_REGION=us-east-2 \
#       aws-delete-route-servers
#
# Only ever touches the route server tagged <infra>-rs, so it cannot
# take out somebody else's.

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/aws-lib.bash"

parse_args_only_common "$@"
# oc, because the infra id and region come from the running cluster
# unless INFRA and AWS_REGION are set. Declaring it means a missing oc
# says so up front instead of failing with a bare "command not found"
# forty lines in.
require_cmd aws oc
require_aws

# Predicates for wait_until. Each answers one question about current
# state and says nothing about what to do when the answer is no.
#
# A failed describe call is a failed poll, never an empty answer. These
# used to end in "|| echo 0", which turned expired credentials or
# throttling mid-wait into "nothing left": the wait reported success and
# the deletes that followed hit IncorrectState against resources that
# were still there.

no_pending_peers() {
    local n
    n="$(aws ec2 describe-route-server-peers \
        --query "length(RouteServerPeers[?RouteServerId=='$1' && State=='pending'])" \
        --output text 2>/dev/null)" \
        || { warn "  describe-route-server-peers failed"; return 1; }
    [ "$n" = "0" ] && return 0
    info "  $n peer(s) still pending"
    return 1
}

peers_gone() {
    local n
    n="$(aws ec2 describe-route-server-peers \
        --query "length(RouteServerPeers[?RouteServerId=='$1' && State!='deleted'])" \
        --output text 2>/dev/null)" \
        || { warn "  describe-route-server-peers failed"; return 1; }
    [ "$n" = "0" ] && return 0
    info "  $n peer(s) still deleting"
    return 1
}

no_pending_endpoints() {
    local n
    n="$(aws ec2 describe-route-server-endpoints \
        --query "length(RouteServerEndpoints[?RouteServerId=='$1' && State=='pending'])" \
        --output text 2>/dev/null)" \
        || { warn "  describe-route-server-endpoints failed"; return 1; }
    [ "$n" = "0" ] && return 0
    info "  $n endpoint(s) still pending"
    return 1
}

endpoints_gone() {
    local n
    n="$(aws ec2 describe-route-server-endpoints \
        --query "length(RouteServerEndpoints[?RouteServerId=='$1' && State!='deleted'])" \
        --output text 2>/dev/null)" \
        || { warn "  describe-route-server-endpoints failed"; return 1; }
    [ "$n" = "0" ]
}

# AWS reports "this route server has no associations" as an error rather than
# as an empty list:
#
#   InvalidRouteServerId.NotAssociated: Route Server rs-... is not associated
#   with a VPC.
#
# So the state being waited for is the state that makes the call fail. Reading
# every error as a failed poll meant this could never succeed: it burned the
# full 600s timeout on every delete and then reported a failure that had not
# happened. Distinguish the two rather than swallowing all errors, so a
# genuine API problem still stops us.
associations_cleared() {
    local out
    if out="$(aws ec2 get-route-server-associations --route-server-id "$1" \
        --query 'length(RouteServerAssociations)' --output text 2>&1)"; then
        [ "$out" = "0" ]
        return
    fi
    case "$out" in
        *NotAssociated*) return 0 ;;
    esac
    warn "  get-route-server-associations failed: $out"
    return 1
}


infra="${INFRA:-}"
if [ -z "$infra" ]; then
    if ! infra="$(oc get infrastructure cluster -o jsonpath='{.status.infrastructureName}' 2>/dev/null)" || [ -z "$infra" ]; then
        echo "Error: no cluster reachable and INFRA is not set" >&2
        echo "If the cluster is gone, name it: INFRA=<name> AWS_REGION=<region> ${0##*/}" >&2
        exit 1
    fi

    # The cluster wins over AWS_REGION, for the reason aws-destroy-cluster
    # spells out: AWS_REGION is exported into every shell, so ":=" let an
    # ambient us-west-2 quietly beat the us-east-2 a cluster was built in.
    #
    # Here that is worse than it is there. Everything below filters on a tag
    # in one region, so the wrong region finds no route server and reports
    # "Nothing to do" -- and nothing to do is indistinguishable from nothing
    # left. You would destroy the cluster believing the estate was clean and
    # leave a route server, six endpoints and seven propagations behind, in a
    # VPC that no longer exists. Observed 2026-08-13.
    #
    # Say so when the environment disagreed rather than discarding it in
    # silence, because the one case that is not a stale shell is somebody who
    # meant it.
    cluster_region="$(oc get infrastructure cluster -o jsonpath='{.status.platformStatus.aws.region}' 2>/dev/null || true)"
    if [ -n "$cluster_region" ]; then
        if [ -n "${AWS_REGION:-}" ] && [ "$AWS_REGION" != "$cluster_region" ]; then
            warn "AWS_REGION is $AWS_REGION, but the cluster reports $cluster_region."
            warn "Using $cluster_region, which is where its route servers are."
        fi
        AWS_REGION="$cluster_region"
    fi
fi

if [ -z "${AWS_REGION:-}" ]; then
    echo "Error: AWS_REGION is not set and could not be read from a cluster" >&2
    exit 1
fi
export AWS_REGION

# Tag filter server-side, state filter client-side: a deleted route
# server keeps its tag and keeps being returned, so selecting on the tag
# alone offers to delete something AWS removed hours ago.
rs="$(aws ec2 describe-route-servers \
    --filters "Name=tag:Name,Values=$infra-rs" \
    --query "RouteServers[?State!='deleted' && State!='deleting'].RouteServerId | [0]" \
    --output text 2>/dev/null || echo None)"

if [ "$rs" = "None" ] || [ -z "$rs" ]; then
    echo "Nothing to do: no route server tagged $infra-rs in $AWS_REGION"
    exit 0
fi

echo "Region:       $AWS_REGION"
echo "Cluster:      $infra"
echo "Route server: $rs"
echo

# An endpoint still coming up can be neither deleted (IncorrectState)
# nor skipped: leaving it out of the selection below deletes the route
# server out from under it and leaves the endpoint behind, billing.
# Wait for the state to settle before deciding what exists.
if [ "$dry_run" = false ]; then
    wait_until 300 10 "endpoints to leave pending" no_pending_endpoints "$rs" \
        || fail "endpoints still pending; they will be missed below"
fi

# DescribeRouteServerEndpoints and DescribeRouteServerPeers both
# reject route-server-id and route-server-endpoint-id as filters, so
# every selection here happens client-side.
# Only endpoints that are alive can be deleted, for the same reason as
# peers below: AWS keeps listing them once gone and rejects a delete of
# one already deleted with IncorrectState.
endpoints="$(aws ec2 describe-route-server-endpoints \
    --query "RouteServerEndpoints[?RouteServerId=='$rs' && State=='available'].RouteServerEndpointId" --output text)"

vpcs="$(aws ec2 get-route-server-associations --route-server-id "$rs" \
    --query 'RouteServerAssociations[].VpcId' --output text 2>/dev/null || echo "")"

echo "Will delete:"
if [ -z "$endpoints" ]; then echo "  (no live endpoints)"; fi
for e in $endpoints; do echo "  endpoint $e"; done
for v in $vpcs; do echo "  association with $v"; done
echo "  route server $rs"
echo


# Peers hold endpoints open, so they go first. The operator creates
# these, which is why they may exist even though we never made any.
#
# Only peers that are actually alive can be deleted. AWS keeps listing
# peers for a long time after removing them, and rejects a delete of one
# already gone, or of one still coming up, with IncorrectState:
#
#   An error occurred (IncorrectState): Route Server Peer rsp-... is in
#   an invalid state.
#
# So wait out anything still pending, then delete only what is available.
if [ "$dry_run" = false ] && [ -n "$endpoints" ]; then
    wait_until 300 10 "peers to leave pending" no_pending_peers "$rs" \
        || fail "peers still pending; deletes below may hit IncorrectState"
fi

# Failures are recorded, not fatal: a delete that trips set -e here
# skips everything after it, including the summary, which is exactly
# how resources get left behind unreported.
for e in $endpoints; do
    peers="$(aws ec2 describe-route-server-peers \
        --query "RouteServerPeers[?RouteServerEndpointId=='$e' && State=='available'].RouteServerPeerId" \
        --output text)"
    for p in $peers; do
        echo "Deleting peer $p"
        try aws ec2 delete-route-server-peer --route-server-peer-id "$p" \
            || fail "delete peer $p"
    done
done

# Deleting a peer only moves it to "deleting", and an endpoint refuses
# to go while it still has a non-deleted peer:
#
#   An error occurred (IncorrectState) when calling
#   DeleteRouteServerEndpoint: Route Server Endpoint has non-deleted
#   Route Server Peer: rsp-...
#
# The wait above is for peers to leave "pending" before we delete them.
# This one is for them to finish leaving after we have. Both are needed
# and only having the first is how this failed.
if [ "$dry_run" = false ] && [ -n "$endpoints" ]; then
    echo "Waiting for peers to finish deleting..."
    wait_until 600 10 "peers to finish deleting" peers_gone "$rs" \
        || fail "peers did not finish deleting; endpoint deletes will fail"
fi

# Same hazard as associations_cleared above: an empty result may come back as
# an error rather than a zero, so a "nothing left" answer must not read as a
# failed poll.
propagations_cleared() {
    local out
    if out="$(aws ec2 get-route-server-propagations --route-server-id "$1" \
        --query "length(RouteServerPropagations[?State!='deleted'])" \
        --output text 2>&1)"; then
        [ "$out" = "0" ]
        return
    fi
    case "$out" in
        *NotAssociated*|*NotFound*|*NoSuch*) return 0 ;;
    esac
    warn "  get-route-server-propagations failed: $out"
    return 1
}

for e in $endpoints; do
    echo "Deleting endpoint $e"
    try aws ec2 delete-route-server-endpoint --route-server-endpoint-id "$e" \
        || fail "delete endpoint $e"
done

# Not gated on whether we deleted any: an endpoint a previous run left
# in "deleting" still blocks the route server delete below, and if none
# ever existed the first poll answers instantly.
if [ "$dry_run" = false ]; then
    echo "Waiting for endpoints to go away..."
    wait_until 600 10 "endpoints to go away" endpoints_gone "$rs" \
        || fail "endpoints did not go away"
fi

# Propagations before the association, mirroring the order Terraform
# destroys in: the propagation depends on the association, so removing
# the association first leaves a dependency pointing at something that
# has gone.
propagations="$(aws ec2 get-route-server-propagations --route-server-id "$rs" \
    --query "RouteServerPropagations[?State!='deleted' && State!='deleting'].RouteTableId" \
    --output text 2>/dev/null | tr '\t' '\n' | grep . || true)"

for rt in $propagations; do
    echo "Disabling propagation to $rt"
    try aws ec2 disable-route-server-propagation --route-server-id "$rs" --route-table-id "$rt" \
        || fail "disable propagation to $rt"
done

if [ "$dry_run" = false ] && [ -n "$propagations" ]; then
    echo "Waiting for propagations to clear..."
    wait_until 600 10 "propagations to clear" propagations_cleared "$rs" \
        || fail "propagations did not clear"
fi

for v in $vpcs; do
    echo "Disassociating from $v"
    try aws ec2 disassociate-route-server --route-server-id "$rs" --vpc-id "$v" \
        || fail "disassociate from $v"
done

if [ "$dry_run" = false ] && [ -n "$vpcs" ]; then
    echo "Waiting for associations to clear..."
    wait_until 600 10 "associations to clear" associations_cleared "$rs" \
        || fail "associations did not clear"
fi

echo "Deleting route server $rs"
try aws ec2 delete-route-server --route-server-id "$rs" \
    || fail "delete route server $rs"

report
