#!/usr/bin/env bash
#
# Tear down a cluster built by aro-hcp-create-cluster.
#
#   CLUSTER=$PWD/clusters/<YYMMDDHHMM>-aro-hcp-OCP-<version> aro-hcp-destroy-cluster --dry-run
#   CLUSTER=$PWD/clusters/<YYMMDDHHMM>-aro-hcp-OCP-<version> aro-hcp-destroy-cluster
#
# Three things to remove, in this order:
#
#   1. the cluster, with a DELETE on the hcpOpenShiftClusters resource.
#      Its node pools and the managed group, aro-<cluster>, go with it.
#   2. the cluster's resource group, which holds everything
#      aro-hcp-create-cluster made: vnet, NSG, Key Vault and the thirteen
#      managed identities.
#   3. the Key Vault, which deleting the group only moves into soft
#      delete, where its name stays taken until it is purged.
#
# The group waits for the cluster to be confirmed gone. The cluster's
# identities and network are in that group, and pulling them out from
# under a cluster the service is still running, or still deleting, is
# how a delete gets stuck.
#
# The cluster counts as gone only on ResourceNotFound or
# ResourceGroupNotFound; any other failure to look stops the run, as in
# aro-destroy-cluster. Every name comes from cluster-facts, written
# before anything existed, and the recorded subscription is passed to
# every call.

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/azure-lib.bash"

parse_args_only_common "$@"
require_cmd jq
require_azure

[ -n "${CLUSTER:-}" ] || die "CLUSTER is not set" \
    "Point it at the cluster directory:" \
    "  CLUSTER=\$PWD/clusters/<YYMMDDHHMM>-aro-hcp-OCP-<version> ${0##*/}"

facts="$CLUSTER/cluster-facts"
[ -f "$facts" ] || die "no cluster-facts in $CLUSTER"

read_fact() {
    awk -F= -v k="$2" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$1"
}

cloud="$(read_fact "$facts" cloud)"
[ "$cloud" = "aro-hcp" ] || die "this cluster directory belongs to ${cloud:-an unknown cloud}" \
    "Use ${cloud:-the matching}-destroy-cluster instead."

cluster_name="$(read_fact "$facts" cluster_name)"
resource_group="$(read_fact "$facts" resource_group)"
managed_resource_group="$(read_fact "$facts" managed_resource_group)"
key_vault="$(read_fact "$facts" key_vault)"
subscription="$(read_fact "$facts" subscription)"
region="$(read_fact "$facts" region)"
api="$(read_fact "$facts" api_version)"

for k in cluster_name resource_group managed_resource_group key_vault subscription region api; do
    [ -n "${!k}" ] || die "cluster-facts has no ${k/api/api_version}" "It is written by aro-hcp-create-cluster; is $facts one of its?"
done

if [ "$subscription" != "$(azure_active_subscription)" ]; then
    warn "az is on $(azure_active_subscription); the cluster was built in $subscription, using that"
fi

sub=(--subscription "$subscription")
cluster_url="https://management.azure.com/subscriptions/$subscription/resourceGroups/$resource_group/providers/Microsoft.RedHatOpenShift/hcpOpenShiftClusters/$cluster_name?api-version=$api"

# Prints present or absent, or fails having said why it could not tell.
cluster_state() {
    local out
    if capture out az rest --method GET --url "$cluster_url" --output none; then
        echo present
    elif grep -qE '"code": ?"(ResourceNotFound|ResourceGroupNotFound)"' <<<"$out"; then
        echo absent
    else
        warn "  could not tell whether the cluster exists:"
        explain "$out"
        return 1
    fi
}

cluster_absent() {
    local state
    state="$(cluster_state)" || return 1
    [ "$state" = "absent" ]
}

group_exists() {
    local out
    out="$(az group exists "${sub[@]}" --name "$1")" || return 1
    [ "$out" = "true" ]
}

vault_soft_deleted() {
    local out
    out="$(az keyvault list-deleted "${sub[@]}" --resource-type vault \
        --query "[?name=='$key_vault'].name" -o tsv)" || return 1
    [ -n "$out" ]
}

info "Subscription:   $subscription"
info "Cluster:        $cluster_name ($region)"
info "Resource group: $resource_group"
info "Managed group:  $managed_resource_group"
info "Key Vault:      $key_vault"
info ""

cluster_gone=false

delete_cluster() {
    local state
    state="$(cluster_state)" || return 1
    if [ "$state" = "absent" ]; then
        info "  no cluster resource"
        cluster_gone=true
        return 0
    fi
    try az rest --method DELETE --url "$cluster_url" --output none || return 1
    if [ "$dry_run" = true ]; then
        cluster_gone=true
        return 0
    fi
    wait_until 3600 30 "the cluster to be deleted" cluster_absent || return 1
    cluster_gone=true
}

delete_group() {
    if [ "$cluster_gone" != true ]; then
        warn "  the cluster may still exist; not deleting the group beneath it"
        return 1
    fi
    if ! group_exists "$resource_group"; then
        info "  no resource group $resource_group"
        return 0
    fi
    try az group delete "${sub[@]}" --yes --name "$resource_group"
}

purge_vault() {
    if [ "$dry_run" = true ]; then
        info "  would purge $key_vault from soft delete, once the group has gone"
        return 0
    fi
    if ! vault_soft_deleted; then
        info "  $key_vault is not in soft delete"
        return 0
    fi
    try az keyvault purge "${sub[@]}" --name "$key_vault" --location "$region"
}

# Look rather than trust. A lookup that fails is a failure, never an
# empty answer.
audit() {
    if [ "$dry_run" = true ]; then
        info "  (skipped: nothing was deleted)"
        return 0
    fi
    local left=false state
    state="$(cluster_state)" || return 1
    [ "$state" = "absent" ] || { warn "  cluster     $cluster_name"; left=true; }
    for g in "$resource_group" "$managed_resource_group"; do
        if group_exists "$g"; then
            warn "  group       $g"
            left=true
        fi
    done
    if vault_soft_deleted; then
        warn "  vault       $key_vault (soft-deleted)"
        left=true
    fi
    [ "$left" = false ] || return 1
    info "  nothing"
}

phase "cluster"          delete_cluster
phase "resource group"   delete_group
phase "Key Vault purge"  purge_vault
phase "remaining"        audit

info "Cloud resources only. This directory is untouched:"
info "  $CLUSTER"
report
