#!/usr/bin/env bash
#
# Write an install-config.yaml for an AWS cluster.
#
#   aws-create-install-config ~/.secrets/install-config.yaml
#   CONTROL_PLANE_REPLICAS=1 aws-create-install-config /tmp/cheap.yaml
#
# Three control-plane nodes by default, and that is deliberate rather
# than habit. With one master every kube-apiserver revision takes the
# whole API down until it finishes, so routine operator rollouts look
# like an outage. Worse, during bootstrap teardown etcd briefly has two
# members, and a majority of two is two: losing either loses quorum,
# and the etcd operator cannot remove a dead member without quorum to
# do it with. Three masters costs two extra m6i.xlarge and removes both
# problems.
#
# CLUSTER_NAME goes in as a real name. There used to be a literal
# $CLUSTER_NAME placeholder here for cluster.sh to substitute, which
# meant the file this produced was only usable by that one script, and
# openshift-install rejected it with "metadata.name: Invalid value" if
# anything else consumed it.
#
# Environment, all optional except where the default cannot be guessed:
#
#   BASE_DOMAIN             default qe.devcluster.openshift.com
#   AWS_REGION              default us-east-2
#   CONTROL_PLANE_REPLICAS  default 3
#   WORKER_REPLICAS         default 3
#   CONTROL_PLANE_TYPE      default m6i.xlarge
#   WORKER_TYPE             default m6i.xlarge
#   CLUSTER_NAME            default <user>-<YYMMDDHHMM>
#   SSH_KEY                 path to a public key, default ~/.ssh/id_ed25519.pub
#   PULL_SECRET             path to pull-secret json, default ~/.secrets/pull-secret.json

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.bash"

parse_common_args "$@"
if [ ${#rest[@]} -ne 1 ]; then
    die "need exactly one output path" \
        "Usage: ${0##*/} [--dry-run] <output-file>" \
        "Overwrites the output file without asking."
fi
out="${rest[0]}"

require_cmd jq

base_domain="${BASE_DOMAIN:-qe.devcluster.openshift.com}"
region="${AWS_REGION:-us-east-2}"
control_plane_replicas="${CONTROL_PLANE_REPLICAS:-3}"
worker_replicas="${WORKER_REPLICAS:-3}"
control_plane_type="${CONTROL_PLANE_TYPE:-m6i.xlarge}"
worker_type="${WORKER_TYPE:-m6i.xlarge}"
ssh_key="${SSH_KEY:-$HOME/.ssh/id_ed25519.pub}"
cluster_name="${CLUSTER_NAME:-${CLUSTER_USER:-${USER:-$(whoami)}}-$(date +%y%m%d%H%M)}"
pull_secret="${PULL_SECRET:-$HOME/.secrets/pull-secret.json}"

[ -f "$ssh_key" ] || die "no ssh public key at $ssh_key" \
    "Set SSH_KEY to the one you want baked into the nodes."

[ -f "$pull_secret" ] || die "no pull secret at $pull_secret" \
    "Get one from console.redhat.com, or set PULL_SECRET." \
    "If you also want CI payloads, merge in registry.ci.openshift.org:" \
    "oc registry login --to \$PULL_SECRET"

jq -e . "$pull_secret" >/dev/null 2>&1 \
    || die "$pull_secret is not valid JSON"

# Overwrites without asking. aws-create-cluster always points this at a
# directory the preflight has already proved empty, and a refusal you can
# only get past with a flag is the same obstacle by another name.

if [ "$control_plane_replicas" != "3" ]; then
    warn "control plane replicas is $control_plane_replicas, not 3."
    warn "Every kube-apiserver rollout will interrupt the API."
fi

if [ "$dry_run" = true ]; then
    info "  would write $out"
    info "    baseDomain    $base_domain"
    info "    region        $region"
    info "    control plane $control_plane_replicas x $control_plane_type"
    info "    workers       $worker_replicas x $worker_type"
    info "    sshKey        $ssh_key"
    info "    pullSecret    $pull_secret"
    info "    clusterName   $cluster_name"
    report
    exit $?
fi

# Written with a restrictive umask because the pull secret goes inside.
old_umask="$(umask)"
umask 077
cat > "$out" <<EOF
additionalTrustBundlePolicy: Proxyonly
apiVersion: v1
baseDomain: $base_domain
credentialsMode: Manual
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform:
    aws:
      type: $worker_type
  replicas: $worker_replicas
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform:
    aws:
      type: $control_plane_type
  replicas: $control_plane_replicas
metadata:
  creationTimestamp: null
  name: $cluster_name
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 10.0.0.0/16
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  aws:
    region: $region
publish: External
sshKey: |
  $(cat "$ssh_key")
pullSecret: '$(jq -c . "$pull_secret")'
EOF
umask "$old_umask"

info "Wrote $out"
info "  cluster name  $cluster_name"
info "  control plane $control_plane_replicas x $control_plane_type"
info "  workers       $worker_replicas x $worker_type"
info "  region        $region"
info "  baseDomain    $base_domain"
report
