#!/usr/bin/env bash
#
# Ensure the service principal openshift-install needs on Azure, and the
# credentials file it reads.
#
#   azure-installer-credentials --dry-run
#   azure-installer-credentials
#
# openshift-install wants a service principal, not your az login: the
# cloud credential operator runs in Passthrough on Azure and copies that
# credential into each component, and a user credential is not something
# you can embed. So: one application per person, Contributor and User
# Access Administrator on the subscription, and a secret on disk at the
# path the installer already looks in.
#
# Both roles are needed and neither is optional. Contributor builds the
# cluster; User Access Administrator exists because the installer
# creates a user-assigned managed identity for the cluster and assigns
# it a role, and Contributor explicitly cannot -- Microsoft.Authorization/*/Write
# is in its notActions. An install with Contributor alone gets a long
# way in and then fails on the role assignment.
#
# Registering an application and granting it a role are separate
# permissions, and a tenant may well give you the first without the
# second: Application Developer registers applications, while assigning
# a role needs Owner, User Access Administrator or Role Based Access
# Control Administrator on the subscription. So the two are separate
# steps here. Registering happens whatever your permissions, because the
# application id is exactly what somebody with the second permission
# needs from you; the grant is attempted, and where it cannot be, the
# refusal names that id and the commands to hand over. Run it again
# afterwards and it finds the roles in place and mints the secret.
#
# Secrets expire, unlike GCP service-account keys. AZURE_SP_YEARS sets
# how long, and the installer holds its credentials in memory for the
# whole run, so the AWS session-shorter-than-the-install race does not
# arise at a year.
#
# Environment:
#
#   AZURE_SP_NAME        default <user>-openshift-installer
#   AZURE_AUTH_LOCATION  where the credentials land,
#                        default ~/.azure/osServicePrincipal.json
#   AZURE_SP_YEARS       secret lifetime, default 1

set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$here/azure-lib.bash"

parse_args_only_common "$@"
require_cmd az jq
require_azure

sp_name="${AZURE_SP_NAME:-${CLUSTER_USER:-${USER:-$(whoami)}}-openshift-installer}"
creds_file="$(azure_credentials_file)"
years="${AZURE_SP_YEARS:-1}"

subscription="$(azure_active_subscription)"
[ -n "$subscription" ] || die "az has no subscription selected" \
    "Pick one: az account set --subscription <id>"
tenant="$(az account show --query tenantId -o tsv)"
scope="/subscriptions/$subscription"

# The two roles the installer needs, and the only three built-in roles
# that can grant them.
installer_roles=("Contributor" "User Access Administrator")
granting_roles='^(Owner|User Access Administrator|Role Based Access Control Administrator)$'

# Two flags carry the whole meaning here. --include-groups, because a
# subscription hands its roles to a group and puts people in the group,
# so the assignment naming you personally is not the one that matters;
# without it this reads Contributor, refuses, and prints instructions for
# a permission you already hold. --scope with --include-inherited rather
# than --all, because the question is what you can do to this
# subscription: Owner on some unrelated resource group is not an answer,
# and --all would count it.
can_assign_roles() {
    local me roles
    me="$(az ad signed-in-user show --query id -o tsv 2>/dev/null)" || return 1
    roles="$(az role assignment list --assignee "$me" --scope "$scope" \
        --include-groups --include-inherited \
        --query '[].roleDefinitionName' -o tsv 2>/dev/null)" || return 1
    printf '%s\n' "$roles" | grep -qE "$granting_roles"
}

app_id() {
    az ad app list --display-name "$sp_name" --query '[0].appId' -o tsv 2>/dev/null
}

role_assigned() {
    [ -n "$(az role assignment list --assignee "$1" --role "$2" --scope "$scope" \
        --query '[0].id' -o tsv 2>/dev/null)" ]
}

info "Subscription: $subscription"
info "Tenant:       $tenant"
info "Application:  $sp_name"
info "Creds file:   $creds_file"
info ""

# ---------------------------------------------------------------------
# Steps
# ---------------------------------------------------------------------

ensure_app() {
    local id
    id="$(app_id)"
    if [ -n "$id" ]; then
        info "  $sp_name already registered as $id"
        return 0
    fi
    if [ "$dry_run" = true ]; then
        info "  would register $sp_name"
        return 0
    fi
    # app create then sp create, rather than the one create-for-rbac
    # call that does both: create-for-rbac always mints a password and
    # prints it once, and a password minted here is one thrown away,
    # because the secret we keep is the one ensure_secret writes into
    # the file. The role assignment it can also do is a separate step
    # below for the same reason it is a separate permission.
    id="$(az ad app create --display-name "$sp_name" --query appId -o tsv)" || return 1
    az ad sp create --id "$id" --output none || return 1
    info "  registered $sp_name as $id"
}

ensure_roles() {
    local id role missing=()
    id="$(app_id)"
    if [ -z "$id" ]; then
        if [ "$dry_run" = true ]; then
            info "  would grant ${installer_roles[*]} once the application exists"
            return 0
        fi
        return 1
    fi
    # Creating an assignment that already exists exits non-zero, so what
    # is already there is what we test for rather than the create's
    # status.
    for role in "${installer_roles[@]}"; do
        if role_assigned "$id" "$role"; then
            info "  $role already assigned"
        else
            missing+=("$role")
        fi
    done
    [ ${#missing[@]} -eq 0 ] && return 0

    if can_assign_roles; then
        for role in "${missing[@]}"; do
            try az role assignment create --assignee "$id" --role "$role" \
                --scope "$scope" --output none || return 1
        done
        return 0
    fi

    # As far as you can take it alone. The application id is the thing
    # somebody with the permission needs from you, so the refusal is
    # written to be forwarded rather than merely read.
    local lines=()
    for role in "${missing[@]}"; do
        lines+=("  az role assignment create --assignee $id --role '$role' --scope $scope")
    done
    die "cannot grant ${missing[*]} to $sp_name" \
        "$sp_name is registered as $id and that is as far as you can take it:" \
        "assigning a role needs Owner, User Access Administrator or Role Based" \
        "Access Control Administrator on the subscription, and you hold none." \
        "" \
        "Send these to whoever owns the subscription:" \
        "${lines[@]}" \
        "" \
        "Then run this again. It will find the roles in place and mint the secret." \
        "" \
        "The other way out is the client id and secret of a principal that already" \
        "holds them, written into $creds_file yourself:" \
        "  {\"subscriptionId\":\"$subscription\",\"tenantId\":\"$tenant\",\"clientId\":\"...\",\"clientSecret\":\"...\"}"
}

# A secret cannot be read back after it is minted, so an existing file
# is the only evidence we have that one is still in hand. Absent file,
# fresh secret -- which adds a credential to the application rather than
# replacing it, and the old ones stay until they expire.
#
# The file is only that evidence if it describes this application in this
# subscription and tenant. The path is a fixed one the installer picked,
# so whatever a previous cluster left there is sitting in the way, and a
# credential for a subscription you are not installing into looks exactly
# like a credential you already have. Refuse rather than reuse or
# overwrite: overwriting throws away a bearer credential we cannot read
# back, and reusing installs into the wrong subscription.
ensure_secret() {
    local id
    id="$(app_id)"
    if [ -f "$creds_file" ] \
        && [ "$(jq -r '.clientSecret // empty' "$creds_file" 2>/dev/null)" != "" ]; then
        local was_sub was_tenant was_client mismatch=()
        was_sub="$(jq -r '.subscriptionId // empty' "$creds_file")"
        was_tenant="$(jq -r '.tenantId // empty' "$creds_file")"
        was_client="$(jq -r '.clientId // empty' "$creds_file")"
        [ "$was_sub" = "$subscription" ] || mismatch+=("  subscription $was_sub, wanted $subscription")
        [ "$was_tenant" = "$tenant" ]    || mismatch+=("  tenant       $was_tenant, wanted $tenant")
        [ "$was_client" = "$id" ]        || mismatch+=("  application  $was_client, wanted ${id:-$sp_name}")
        if [ ${#mismatch[@]} -eq 0 ]; then
            info "  credentials already at $creds_file"
            return 0
        fi
        die "$creds_file holds a credential for something else" \
            "${mismatch[@]}" \
            "" \
            "Its secret cannot be read back, so this will not overwrite it." \
            "Move it aside and run this again:" \
            "  mv $creds_file $creds_file.$(date +%Y%m%d)" \
            "" \
            "Or keep both and point this run elsewhere with AZURE_AUTH_LOCATION."
    fi
    if [ "$dry_run" = true ]; then
        info "  would mint a ${years}-year secret for ${id:-$sp_name} into $creds_file"
        return 0
    fi
    [ -n "$id" ] || return 1
    local secret
    secret="$(az ad app credential reset --id "$id" --years "$years" \
        --query password -o tsv)" || return 1
    mkdir -p "$(dirname "$creds_file")"
    # umask, because this is a bearer credential for something holding
    # Contributor on the whole subscription.
    ( umask 077; jq -n \
        --arg s "$subscription" --arg t "$tenant" --arg c "$id" --arg p "$secret" \
        '{subscriptionId:$s, tenantId:$t, clientId:$c, clientSecret:$p}' \
        > "$creds_file" )
    info "  wrote $creds_file"
}

# Minting a credential and never using it means a propagation delay or a
# missed role assignment surfaces thirty seconds into openshift-install
# rather than here, in the thing that created it. So use it.
#
# The subscription matters as much as the login. A principal with a good
# secret and no effective role assignment authenticates perfectly well
# and sees nothing at all, and that is what propagation looks like from
# the outside: observed here, a freshly assigned principal reporting "No
# subscriptions found" and succeeding a minute later. Hence the retry,
# and hence checking what it can see rather than only that it got in.
#
# In its own AZURE_CONFIG_DIR, because logging in as a service principal
# otherwise replaces your own login in ~/.azure and leaves you
# authenticated as the installer without having said so.
verify_err=""
credential_works() {
    local tmp="$1" id seen
    id="$(jq -r '.clientId // empty' "$creds_file")"
    capture verify_err env AZURE_CONFIG_DIR="$tmp/az" \
        az login --service-principal --tenant "$tenant" \
        -u "$id" -p "@$tmp/secret" --output none || return 1
    seen="$(env AZURE_CONFIG_DIR="$tmp/az" az account show --query id -o tsv 2>/dev/null)"
    [ "$seen" = "$subscription" ] && return 0
    verify_err="logged in, but the subscription it sees is ${seen:-none}, not $subscription"
    return 1
}

verify_credential() {
    if [ "$dry_run" = true ]; then
        info "  would log in as $sp_name and check it sees $subscription"
        return 0
    fi
    local tmp rc=0
    tmp="$(mktemp -d)" || return 1
    # Via a file, not the command line: az takes @path for the secret,
    # and an argument is readable out of /proc by anything on the box.
    ( umask 077; jq -r '.clientSecret // empty' "$creds_file" > "$tmp/secret" ) \
        || { rm -rf "$tmp"; return 1; }
    retry 8 15 credential_works "$tmp" || rc=$?
    rm -rf "$tmp"
    if [ "$rc" -ne 0 ]; then
        explain "$verify_err"
        warn "  If that is not propagation, the secret in $creds_file is not one"
        warn "  $sp_name will accept. Move the file aside and run this again to"
        warn "  mint a fresh one."
        return "$rc"
    fi
    info "  $sp_name authenticates and sees $subscription"
}

step "application"  ensure_app
step "roles"        ensure_roles
step "secret"       ensure_secret
step "verify"       verify_credential

info ""
info "openshift-install reads $creds_file by itself."
info "Point it elsewhere with AZURE_AUTH_LOCATION."
report
