#!/usr/bin/env bash
#
# Write an install-config.yaml for a GCP cluster.
#
#   gcp-create-install-config ~/.secrets/install-config.yaml
#   CONTROL_PLANE_REPLICAS=1 gcp-create-install-config /tmp/cheap.yaml
#
# Three control-plane nodes by default, for the same reasons as the
# AWS script: one master turns every kube-apiserver rollout into an
# API outage, and during bootstrap teardown a two-member etcd is a
# quorum deadlock waiting for either member to blink.
#
# No credentialsMode line, and that is the difference that matters
# next to the AWS config. The default is mint: the cloud credential operator uses
# the Owner service account to create a per-component service account
# for each CredentialsRequest and removes them again on destroy. The
# AWS account's restricted role cannot mint, which is what forces
# Manual and the whole ccoctl dance over there. Here there is nothing
# to extract, nothing to merge and nothing created before the
# installer runs.
#
# GCP_BASE_DOMAIN is discovered, not defaulted. The AWS script can bake
# qe.devcluster.openshift.com in because that zone is a fixture of the
# QE account; the GCP project's zone name was not verifiable when this
# was written, and an unverified constant is a trap. If the project
# has exactly one public Cloud DNS zone, that is the answer;
# otherwise set GCP_BASE_DOMAIN and the error lists the candidates.
#
# Environment:
#
#   GCP_PROJECT             required; becomes platform.gcp.projectID
#   GCP_BASE_DOMAIN             default: the project's only public DNS zone
#   GCP_REGION              default us-east1
#   CONTROL_PLANE_REPLICAS  default 3
#   WORKER_REPLICAS         default 3
#   CONTROL_PLANE_TYPE      default n2-standard-4
#   WORKER_TYPE             default n2-standard-4
#   CLUSTER_NAME            default <user>-<YYMMDDHHMM>
#   SSH_KEY                 path to a public key, default ~/.ssh/id_ed25519.pub
#   PULL_SECRET             path to pull-secret json, default ~/.secrets/pull-secret.json

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/gcp-lib.bash"

parse_common_args "$@"
if [ ${#rest[@]} -ne 1 ]; then
    die "need exactly one output path" \
        "Usage: ${0##*/} [--dry-run] <output-file>" \
        "Overwrites the output file without asking."
fi
out="${rest[0]}"

require_cmd jq
require_env GCP_PROJECT

region="${GCP_REGION:-us-east1}"
control_plane_replicas="${CONTROL_PLANE_REPLICAS:-3}"
worker_replicas="${WORKER_REPLICAS:-3}"
# n2-standard-4: 4 vCPU, 16GB, the shape m6i.xlarge has on AWS, and
# what the installer would pick for GCP by itself.
control_plane_type="${CONTROL_PLANE_TYPE:-n2-standard-4}"
worker_type="${WORKER_TYPE:-n2-standard-4}"
ssh_key="${SSH_KEY:-$HOME/.ssh/id_ed25519.pub}"
cluster_name="${CLUSTER_NAME:-${CLUSTER_USER:-${USER:-$(whoami)}}-$(date +%y%m%d%H%M)}"
pull_secret="${PULL_SECRET:-$HOME/.secrets/pull-secret.json}"

base_domain="${GCP_BASE_DOMAIN:-}"
if [ -z "$base_domain" ]; then
    # Discovery needs a working gcloud login; a supplied GCP_BASE_DOMAIN
    # does not, which also keeps --dry-run possible offline.
    require_gcp
    zones="$(gcloud dns managed-zones list --project "$GCP_PROJECT" \
        --filter 'visibility=public' --format 'value(dnsName)' 2>/dev/null || true)"
    count="$(printf '%s' "$zones" | grep -c . || true)"
    case "$count" in
        1)
            base_domain="${zones%.}"
            ;;
        0)
            die "no public Cloud DNS zone in $GCP_PROJECT" \
                "The installer needs one to create api.<cluster>.<domain>." \
                "Set GCP_BASE_DOMAIN if the zone lives somewhere unexpected."
            ;;
        *)
            die "$count public DNS zones in $GCP_PROJECT, say which" \
                "Set GCP_BASE_DOMAIN to one of: $(printf '%s' "$zones" | tr '\n' ' ')"
            ;;
    esac
fi

[ -f "$ssh_key" ] || die "no ssh public key at $ssh_key" \
    "Set SSH_KEY to the one you want baked into the nodes."

[ -f "$pull_secret" ] || die "no pull secret at $pull_secret" \
    "Get one from console.redhat.com, or set PULL_SECRET." \
    "If you also want CI payloads, merge in registry.ci.openshift.org:" \
    "oc registry login --to \$PULL_SECRET"

jq -e . "$pull_secret" >/dev/null 2>&1 \
    || die "$pull_secret is not valid JSON"

# Overwrites without asking, same as the AWS script: gcp-create-cluster
# always points this at a directory the preflight has already proved
# empty.

if [ "$control_plane_replicas" != "3" ]; then
    warn "control plane replicas is $control_plane_replicas, not 3."
    warn "Every kube-apiserver rollout will interrupt the API."
fi

if [ "$dry_run" = true ]; then
    info "  would write $out"
    info "    project       $GCP_PROJECT"
    info "    baseDomain    $base_domain"
    info "    region        $region"
    info "    control plane $control_plane_replicas x $control_plane_type"
    info "    workers       $worker_replicas x $worker_type"
    info "    sshKey        $ssh_key"
    info "    pullSecret    $pull_secret"
    info "    clusterName   $cluster_name"
    report
    exit $?
fi

# Written with a restrictive umask because the pull secret goes inside.
old_umask="$(umask)"
umask 077
cat > "$out" <<EOF
additionalTrustBundlePolicy: Proxyonly
apiVersion: v1
baseDomain: $base_domain
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform:
    gcp:
      type: $worker_type
  replicas: $worker_replicas
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform:
    gcp:
      type: $control_plane_type
  replicas: $control_plane_replicas
metadata:
  creationTimestamp: null
  name: $cluster_name
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 10.0.0.0/16
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  gcp:
    projectID: $GCP_PROJECT
    region: $region
publish: External
sshKey: |
  $(cat "$ssh_key")
pullSecret: '$(jq -c . "$pull_secret")'
EOF
umask "$old_umask"

info "Wrote $out"
info "  cluster name  $cluster_name"
info "  project       $GCP_PROJECT"
info "  control plane $control_plane_replicas x $control_plane_type"
info "  workers       $worker_replicas x $worker_type"
info "  region        $region"
info "  baseDomain    $base_domain"
report
