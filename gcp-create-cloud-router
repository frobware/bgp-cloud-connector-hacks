#!/usr/bin/env bash
#
# Create the GCP Cloud Router BGP infrastructure a CUDNBgpConfig needs,
# for a cluster the rosa-bgp Terraform did not build. The GCP
# counterpart of aws-create-route-servers.
#
#   gcp-create-cloud-router --dry-run
#   gcp-create-cloud-router
#   gcp-create-cloud-router --prerequisites-only
#
# It does more than the AWS script does, and deliberately. There, the
# operator creates the per-node peers and the script provisions only
# the static half. This creates the per-node half too, which is what
# you want when driving GCP by hand: rerun it when the nodes change.
#
# --prerequisites-only builds only the half the operator never creates
# -- the hub, the Cloud Router with its interfaces, and the firewall
# rule -- and leaves canIpForward, the spoke and the BGP peers alone.
#
# That is the mode the e2e suite wants, and the distinction is not
# cosmetic. Those three are what the operator itself reconciles, so a
# run that finds them already built adopts them, reports no change, and
# passes every assertion it makes. A completely broken operator looks
# identical. Build the operator's own work for it and the test proves
# nothing.
#
# GCP registers a node twice, and the order matters. A node must be a
# member of the router appliance spoke before a BGP peer naming it will
# be accepted, so the spoke is built before the peers.
#
# ASN sets the Cloud Router's own ASN and must differ from LOCAL_ASN,
# which is the ASN every node advertises with and must match
# spec.bgp.localASN in your CUDNBgpConfig. Equal ASNs make the session
# iBGP, which is not what any of this is built for.
#
# Router nodes are those carrying ROUTER_NODE_LABEL. Label them first;
# with none labelled you get the static half and nothing else, which is
# a legitimate way to run it.
#
# Rerunning adopts whatever already exists rather than creating a
# second set, so it doubles as a check on the current state.

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/gcp-lib.bash"

asn="${ASN:-65000}"
local_asn="${LOCAL_ASN:-65001}"
router_node_label="${ROUTER_NODE_LABEL:-networking.openshift.io/cudn-bgp-router=}"

prerequisites_only=false
parse_common_args "$@"
if [ ${#rest[@]} -gt 0 ]; then
    for arg in "${rest[@]}"; do
        case "$arg" in
            --prerequisites-only) prerequisites_only=true ;;
            *) die "unknown option: $arg" \
                "Usage: ${0##*/} [--dry-run] [--prerequisites-only]" ;;
        esac
    done
fi

require_cmd gcloud oc curl python3

[ "$asn" != "$local_asn" ] || die "ASN and LOCAL_ASN are both $asn" \
    "They are the two ends of an eBGP session and must differ." \
    "The private range is 64512-65534. LOCAL_ASN must match" \
    "spec.bgp.localASN in your CUDNBgpConfig."

oc whoami >/dev/null 2>&1 || die "not connected to a cluster" \
    "This reads the project, region and nodes from the running cluster." \
    "export KUBECONFIG=<cluster>/auth/kubeconfig"

platform="$(oc get infrastructure cluster -o jsonpath='{.status.platformStatus.type}')"
[ "$platform" = "GCP" ] || die "cluster platform is $platform, not GCP" \
    "aws-create-route-servers is the one you want for AWS."

infra="$(oc get infrastructure cluster -o jsonpath='{.status.infrastructureName}')"
region="$(oc get infrastructure cluster -o jsonpath='{.status.platformStatus.gcp.region}')"
project="$(oc get infrastructure cluster -o jsonpath='{.status.platformStatus.gcp.projectID}')"

[ -n "$infra" ] && [ -n "$region" ] && [ -n "$project" ] \
    || die "could not read infrastructureName, region and projectID from the cluster"

# require_gcp wants GCP_PROJECT. The cluster just told us which project
# it is in, and that is more authoritative than .envrc.local, which may
# well name a different one.
export GCP_PROJECT="$project"
require_gcp

# Names match modules/osd-bgp-routing in rh-mobb/osd-gcp-cudn-routing, so
# that a cluster built by hand and one built by the Terraform present the
# operator with the same estate, and so that running the Terraform later
# adopts what is here rather than building a second set alongside it.
hub="$infra-ncc-hub"
spoke="$infra-bgp-spoke"
router="$infra-cudn-cr"

# GCP BGP peers and Cloud Router interfaces are fields inside the
# router resource, not resources in their own right, so they cannot
# carry labels. The name prefix is the only ownership signal available
# -- weaker than the AWS managed-by tag, and the reason this script
# never touches a peer whose name does not start with it.
peer_prefix="cudn-bgp"

# Cloud Router interface names, again matching the Terraform.
iface_prefix="$infra-cr-if"

# For queries only. Anything that mutates spells out `gcloud
# --project=...` so that --dry-run prints a command you can paste,
# rather than the name of a function that exists only in here.
g() { gcloud --project="$project" "$@"; }

info "Cluster:   $infra"
info "Project:   $project"
info "Region:    $region"
info "Cloud Router ASN: $asn"
info "Node ASN:         $local_asn"
info ""

# --- what the nodes are ------------------------------------------------

# Name, zone and internal IP for every labelled node, one per line.
# The node name is the instance name on GCP, and the internal IP is the
# NIC address the Cloud Router will peer with.
nodes="$(oc get nodes -l "$router_node_label" \
    -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.metadata.labels.topology\.kubernetes\.io/zone}{" "}{.status.addresses[?(@.type=="InternalIP")].address}{"\n"}{end}' \
    | grep . || true)"

if [ -z "$nodes" ]; then
    warn "No nodes carry $router_node_label."
    warn "Creating the static half only. Label them and rerun to get the peers:"
    warn "  oc label node <node> $router_node_label"
    info ""
else
    info "Router nodes ($router_node_label):"
    printf '%s\n' "$nodes" | while read -r name zone ip; do
        info "  $name  $zone  $ip"
    done
    info ""
fi

# --- the subnet the interfaces must live in ----------------------------

# Google is explicit that the Cloud Router interface addresses come out
# of the subnet holding the router appliance instances, so this is
# read from a node rather than guessed from the naming convention. With
# no labelled nodes there is nothing to read it from, so fall back to
# the installer's worker subnet name.
first_node="$(printf '%s' "$nodes" | head -1 | awk '{print $1}')"
first_zone="$(printf '%s' "$nodes" | head -1 | awk '{print $2}')"

if [ -n "$first_node" ]; then
    read -r network subnet node_tag < <(g compute instances describe "$first_node" \
        --zone="$first_zone" \
        --format='value(networkInterfaces[0].network,networkInterfaces[0].subnetwork,tags.items[0])' \
        | awk '{print $1, $2, $3}')
    network="${network##*/}"
    subnet="${subnet##*/}"
else
    network="$infra-network"
    subnet="$infra-worker-subnet"
    node_tag="$infra-worker"
fi

[ -n "$network" ] && [ -n "$subnet" ] || die "could not determine the network and subnet"

info "Network:   $network"
info "Subnet:    $subnet"
info ""

# --- ip forwarding ------------------------------------------------------

# This comes first, and not for tidiness. Creating the spoke fails
# outright while a member cannot forward:
#
#   router appliance virtual_machine ".../worker-b-9khtb" does not
#   have canIpForward enabled: invalid argument
#
# Observed 2026-08-11; none of Google's Router appliance documentation
# mentions the ordering. It is a good constraint to have been given.
# canIpForward is GCP's counterpart to clearing SourceDestCheck on AWS,
# where forgetting it is invisible -- BGP establishes, the route
# appears, and the NIC silently drops every packet addressed to a pod
# rather than to the node. GCP refuses to build the registration until
# the node can forward, so you cannot arrive at that state by
# forgetting. You can still arrive at it by turning canIpForward off
# afterwards, which nothing here would notice.
#
# gcloud cannot do this: there is no --can-ip-forward on
# `instances update` in v1, beta or alpha, so it goes through the API.
# instances.update has no PATCH semantics -- whatever the body omits is
# treated as deleted -- so this reads the instance, edits one field and
# writes the whole thing back. mostDisruptiveAllowedAction=REFRESH is
# both a promise and a guard: canIpForward needs only a refresh, and
# naming it means the call fails rather than restarting a node if that
# ever stops being true.
api="https://compute.googleapis.com/compute/v1/projects/$project"

set_can_ip_forward() {
    local name="$1" zone="$2" token body

    token="$(gcloud auth print-access-token)" || return 1
    body="$(curl -sf -H "Authorization: Bearer $token" \
        "$api/zones/$zone/instances/$name")" || return 1

    if printf '%s' "$body" | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("canIpForward") else 1)'; then
        info "  $name: already set"
        return 0
    fi

    if [ "$dry_run" = true ]; then
        info "  would run: PUT $api/zones/$zone/instances/$name (canIpForward=true, REFRESH)"
        return 0
    fi

    body="$(printf '%s' "$body" | python3 -c 'import json,sys; o=json.load(sys.stdin); o["canIpForward"]=True; print(json.dumps(o))')" || return 1

    curl -sf -X PUT \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        -d "$body" \
        "$api/zones/$zone/instances/$name?mostDisruptiveAllowedAction=REFRESH" \
        >/dev/null || return 1

    info "  $name: set"
}

if [ "$prerequisites_only" = true ]; then
    info "Skipping canIpForward: --prerequisites-only, the operator sets it"
    info ""
elif [ -n "$nodes" ]; then
    info "Enabling canIpForward on the router nodes:"
    while read -r name zone ip; do
        [ -n "$name" ] || continue
        set_can_ip_forward "$name" "$zone" || fail "canIpForward on $name"
    done < <(printf '%s\n' "$nodes")
    # A spoke naming a node that cannot forward is rejected, so there
    # is nothing to be gained by carrying on to find that out again.
    [ "$(failure_count)" = "0" ] || die "canIpForward failed on at least one node" \
        "The spoke will be rejected while that is true, so stopping here."
    info ""
fi

# --- hub ----------------------------------------------------------------

# Router appliance requires Network Connectivity Center (NCC): a VM
# cannot peer with a Cloud Router unless it is a spoke member, so the
# hub comes before everything.
if g network-connectivity hubs describe "$hub" >/dev/null 2>&1; then
    info "Adopting existing hub $hub"
else
    info "Creating hub $hub..."
    try gcloud --project="$project" network-connectivity hubs create "$hub" \
        --description="CUDN BGP routing for $infra"
fi
info ""

# --- spoke --------------------------------------------------------------

# One spoke for every router node, not one per zone. Google's ASN rules
# say two BGP sessions in different spokes must use different ASNs, and
# every node here advertises with LOCAL_ASN, so they have to share a
# spoke.
appliance_args=()
while read -r name zone ip; do
    [ -n "$name" ] || continue
    appliance_args+=(--router-appliance="instance=projects/$project/zones/$zone/instances/$name,ip=$ip")
done < <(printf '%s\n' "$nodes")

if [ "$prerequisites_only" = true ]; then
    info "Skipping spoke $spoke: --prerequisites-only, the operator creates it"
    info ""
elif g network-connectivity spokes describe "$spoke" --region="$region" >/dev/null 2>&1; then
    # A spoke's membership is replaced wholesale rather than added to,
    # so an update is how a node join or leave is expressed. Skipping
    # it on a rerun would leave the membership stale, which is exactly
    # the drift this script exists to correct.
    if [ ${#appliance_args[@]} -eq 0 ]; then
        info "Adopting existing spoke $spoke, leaving its membership alone (no labelled nodes)"
    else
        info "Updating spoke $spoke membership..."
        try gcloud --project="$project" network-connectivity spokes linked-router-appliances update "$spoke" \
            --region="$region" "${appliance_args[@]}"
    fi
elif [ ${#appliance_args[@]} -eq 0 ]; then
    info "Skipping spoke: it cannot be created without at least one node"
else
    info "Creating spoke $spoke..."
    try gcloud --project="$project" network-connectivity spokes linked-router-appliances create "$spoke" \
        --hub="$hub" --region="$region" \
        --description="CUDN BGP router nodes for $infra" \
        "${appliance_args[@]}"
fi
info ""

# --- cloud router -------------------------------------------------------

# A separate router from the installer's <infra>-network-router, which
# carries Cloud NAT, has no ASN, and is deleted by gcp-destroy-cluster.
# Patching that one would entangle this with the cluster's own
# teardown.
if g compute routers describe "$router" --region="$region" >/dev/null 2>&1; then
    info "Adopting existing Cloud Router $router"
else
    info "Creating Cloud Router $router (ASN $asn)..."
    try gcloud --project="$project" compute routers create "$router" \
        --network="$network" --region="$region" --asn="$asn" \
        --description="CUDN BGP routing for $infra"
fi

# Two interfaces, redundant, because that is what HA looks like on GCP.
# There is no per-zone endpoint to spread across: a GCP subnet is
# regional, so every node peers with these same two addresses whatever
# zone it is in.
#
# --ip-address is deliberately omitted so GCP allocates from the
# subnet. Note that the gcloud help for that flag describes a link
# local address, which is right for HA VPN and Interconnect and wrong
# here: a router appliance peers over the instance's RFC 1918 internal
# address, not 169.254.x.x.
existing_ifaces="$(g compute routers describe "$router" --region="$region" \
    --format='value(interfaces[].name)' 2>/dev/null | tr ';,' '\n' | grep . || true)"

for i in 0 1; do
    iface="$iface_prefix-$i"
    if printf '%s\n' "$existing_ifaces" | grep -qx "$iface"; then
        info "  interface $iface already exists"
        continue
    fi
    info "  adding interface $iface..."
    if [ "$i" = 0 ]; then
        try gcloud --project="$project" compute routers add-interface "$router" \
            --region="$region" --interface-name="$iface" --subnetwork="$subnet"
    else
        try gcloud --project="$project" compute routers add-interface "$router" \
            --region="$region" --interface-name="$iface" --subnetwork="$subnet" \
            --redundant-interface="$iface_prefix-0"
    fi
done
info ""

# --- firewall -----------------------------------------------------------

# Without this nothing peers, and the failure is quiet: FRR sits in
# Active, the Cloud Router sits in Connect, and neither says why. GCP
# denies ingress by default and the installer's rules cover 6443, etcd,
# node ports and geneve, so nothing opens 179. Google mentions it once,
# in a single clause, in the router appliance prerequisites.
#
# Sourced from the two interface addresses rather than the whole subnet,
# because those are the only addresses a Cloud Router peers from, and a
# rule saying so documents itself.
# The Terraform calls this <cluster>-bgp-worker-subnet at priority 900 and
# sources it from the whole worker subnet. The name and priority are matched
# because they are observable; the source range is deliberately left narrower,
# at the two interface addresses, because those are the only addresses a Cloud
# Router peers from and a rule that says so documents itself.
fw="$infra-bgp-worker-subnet"
fw_priority=900

if g compute firewall-rules describe "$fw" >/dev/null 2>&1; then
    info "Adopting existing firewall rule $fw"
elif [ "$dry_run" = true ]; then
    info "Creating firewall rule $fw..."
    info "  would run: gcloud --project=$project compute firewall-rules create $fw --network=$network --direction=INGRESS --action=allow --rules=tcp:179 --source-ranges=<interface addresses> --priority=$fw_priority --target-tags=$node_tag"
else
    # Read the addresses back rather than assuming: they are allocated
    # by GCP unless pinned, and this runs after the interfaces exist.
    fw_sources="$(g compute routers describe "$router" --region="$region" \
        --flatten='interfaces[]' --format='value(interfaces.ipRange)' 2>/dev/null \
        | sed 's#/.*#/32#' | paste -sd, -)"

    if [ -z "$fw_sources" ]; then
        fail "could not read the Cloud Router interface addresses for the firewall rule"
    else
        info "Creating firewall rule $fw (tcp:179 from $fw_sources to $node_tag)..."
        try gcloud --project="$project" compute firewall-rules create "$fw" \
            --network="$network" --direction=INGRESS --action=allow \
            --rules=tcp:179 --source-ranges="$fw_sources" \
            --priority="$fw_priority" \
            --target-tags="$node_tag" \
            --description="BGP from the Cloud Router interfaces to the router nodes"
    fi
fi
info ""

# --- bgp peers ----------------------------------------------------------

existing_peers="$(g compute routers describe "$router" --region="$region" \
    --format='value(bgpPeers[].name)' 2>/dev/null | tr ';,' '\n' | grep . || true)"

if [ "$prerequisites_only" = true ]; then
    info "Skipping BGP peers: --prerequisites-only, the operator creates them"
    info ""
elif [ -n "$nodes" ]; then
    info "BGP peers, two per node:"
    while read -r name zone ip; do
        [ -n "$name" ] || continue
        for i in 0 1; do
            # Peer names are capped at 63 characters and node names are
            # long, so key on the address, which is unique per node and
            # short. The name still has to identify the node for a human
            # reading the router, hence the suffix rather than a hash.
            peer="$peer_prefix-${ip//./-}-$i"
            if printf '%s\n' "$existing_peers" | grep -qx "$peer"; then
                info "  $peer already exists"
                continue
            fi
            info "  adding $peer -> $ip ($name)"
            try gcloud --project="$project" compute routers add-bgp-peer "$router" \
                --region="$region" \
                --peer-name="$peer" \
                --interface="$peer_prefix-if-$i" \
                --peer-ip-address="$ip" \
                --peer-asn="$local_asn" \
                --instance="$name" \
                --instance-zone="$zone"
        done
    done < <(printf '%s\n' "$nodes")
    info ""
fi

# --- what to do with it -------------------------------------------------

if [ "$dry_run" = true ]; then
    report
    exit $?
fi

iface_ips="$(g compute routers describe "$router" --region="$region" \
    --format='value(interfaces[].ipRange)' 2>/dev/null | tr ';,' '\n' | grep . || true)"

info "Cloud Router interfaces:"
g compute routers describe "$router" --region="$region" \
    --format='table(interfaces[].name,interfaces[].ipRange,interfaces[].subnetwork.basename())' 2>/dev/null || true
info ""

# ipRange carries a mask the neighbour address must not. Built here
# rather than inside the heredoc: a pipeline of seds emitting YAML
# inside a command substitution is unreadable and breaks silently on an
# address it did not expect.
neighbors_block=""
while read -r ip; do
    [ -n "$ip" ] || continue
    neighbors_block+="            - address: ${ip%%/*}"$'\n'
    neighbors_block+="              remoteASN: $asn"$'\n'
done < <(printf '%s\n' "$iface_ips")
neighbors_block="${neighbors_block%$'\n'}"

cat <<EOF
Put this in your CUDNBgpConfig. There is no spec.gcp yet, so it goes in
the explicit form -- which is honest about the shape anyway: one entry,
not one per zone, because a GCP subnet is regional and every node peers
with the same two addresses.

  spec:
    bgp:
      localASN: $local_asn
      availabilityZones:
        - nodeSelector:
            ${router_node_label%=*}: "${router_node_label#*=}"
          neighbors:
${neighbors_block}

Still needed before any of it peers:

  ../../openshift/bgp-cloud-connector/worktrees/devenv/enable-frr

and a namespace carrying the two labels the CUDN wants. See RUNBOOK.md.

Check the sessions once the operator has run:

  oc get bgpsessionstates -A
  gcloud compute routers get-status $router --region=$region --project=$project
EOF

report
