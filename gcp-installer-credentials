#!/usr/bin/env bash
#
# Ensure the service account openshift-install needs on GCP, and a key
# file for it.
#
#   gcp-installer-credentials --dry-run
#   gcp-installer-credentials
#
# openshift-install wants a service-account key, not your gcloud
# login: mint-mode CCO embeds the credential in the cluster so it can
# create per-component service accounts, and a user credential is not
# something you can embed. So: one service account per person, with
# roles/owner (mint mode creates service accounts, keys and IAM
# bindings, and the QE project already grants Owner to personal
# accounts), and a key on disk that GOOGLE_CREDENTIALS points at.
#
# Idempotent. The service account is adopted if it already exists, the
# role binding is re-asserted (a no-op when present), and a key is
# only minted when the file is absent. Keys do not expire, so this is
# once per machine, like aws-install-saml -- and unlike AWS there is
# no session-shorter-than-the-install race afterwards.
#
# Environment:
#
#   GCP_PROJECT         required, e.g. from .envrc.local
#   SA_NAME             default <user>-installer
#   GOOGLE_CREDENTIALS  where the key lands,
#                       default ~/.secrets/gcp-osServiceAccount.json

set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$here/gcp-lib.bash"

parse_args_only_common "$@"
require_cmd gcloud jq
require_gcp

sa_name="${SA_NAME:-${CLUSTER_USER:-${USER:-$(whoami)}}-installer}"
sa_email="${sa_name}@${GCP_PROJECT}.iam.gserviceaccount.com"
key_file="${GOOGLE_CREDENTIALS:-$HOME/.secrets/gcp-osServiceAccount.json}"

sa_exists() {
    gcloud iam service-accounts describe "$sa_email" \
        --project "$GCP_PROJECT" >/dev/null 2>&1
}

key_matches() {
    [ -f "$key_file" ] \
        && [ "$(jq -r '.client_email // empty' "$key_file" 2>/dev/null)" = "$sa_email" ]
}

ensure_sa() {
    if sa_exists; then
        info "  $sa_email already exists"
        return 0
    fi
    try gcloud iam service-accounts create "$sa_name" \
        --project "$GCP_PROJECT" \
        --display-name "openshift-install for ${CLUSTER_USER:-${USER:-$(whoami)}}"
}

# Adding a binding that already exists changes nothing, so this is
# safe to re-run. --condition=None, because a policy holding any
# conditional binding otherwise makes gcloud stop and ask, and these
# scripts never prompt. --format none rather than >/dev/null: the
# updated policy on stdout is noise, but a redirect would also swallow
# try's "would run" line in a dry run.
ensure_owner() {
    try gcloud projects add-iam-policy-binding "$GCP_PROJECT" \
        --member "serviceAccount:$sa_email" \
        --role roles/owner \
        --condition=None --format none
}

ensure_key() {
    if key_matches; then
        info "  key already at $key_file"
        return 0
    fi
    # A file that exists but names another account is not ours to
    # replace: it may be the only copy of a key for something else.
    if [ -f "$key_file" ]; then
        die "$key_file exists but is not a key for $sa_email" \
            "It names $(jq -r '.client_email // "no client_email at all"' "$key_file" 2>/dev/null)." \
            "Move it aside, or point GOOGLE_CREDENTIALS somewhere else."
    fi
    if [ "$dry_run" = true ]; then
        info "  would mint a key for $sa_email into $key_file"
        return 0
    fi
    mkdir -p "$(dirname "$key_file")"
    # umask, because the key is a bearer credential for an Owner
    # account.
    ( umask 077; gcloud iam service-accounts keys create "$key_file" \
        --iam-account "$sa_email" --project "$GCP_PROJECT" )
}

info "Project:  $GCP_PROJECT"
info "Account:  $sa_email"
info "Key file: $key_file"
info ""

step "service account" ensure_sa
step "owner binding"   ensure_owner
step "key"             ensure_key

info ""
info "Point the installer at it:"
info "  export GOOGLE_CREDENTIALS=$key_file"
report
