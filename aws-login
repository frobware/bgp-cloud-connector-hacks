#!/usr/bin/env bash
#
# Mint temporary AWS credentials for a Red Hat account over SAML,
# unless the ones you already have still work.
#
#   AWS_ACCOUNT=012345678901 aws-login
#   AWS_ACCOUNT=012345678901 aws-login --force
#
# Then use them:
#
#   export AWS_PROFILE=saml
#
# The account number comes from the environment rather than being
# baked in, so it stays out of a public repository. Set either of
# these in your shell profile and this takes no arguments:
#
#   AWS_ACCOUNT=012345678901
#   AWS_ACCOUNT_PASS=path/to/pass/entry    # first line is the id
#
# Sessions last twelve hours and the credentials file records no
# expiry, so whether the current ones are any good is decided by
# calling sts and seeing what happens.
#
# Overrides: AWS_SAML_PROFILE (default saml), AWS_ROLE (default
# <account>-poweruser), AWS_SESSION_DURATION (default 43200).

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.bash"

account="${AWS_ACCOUNT:-}"

# Fall back to pass, if you have told us which entry to read. The
# entry name is not baked in for the same reason the account number
# is not: it is nobody's business but yours.
if [ -z "$account" ] && [ -n "${AWS_ACCOUNT_PASS:-}" ]; then
    account="$(pass show "$AWS_ACCOUNT_PASS" 2>/dev/null | head -1 || true)"
    if [ -z "$account" ]; then
        echo "Error: could not read an account id from pass entry '$AWS_ACCOUNT_PASS'" >&2
        exit 1
    fi
fi

profile="${AWS_SAML_PROFILE:-saml}"
role="${AWS_ROLE:-${account}-poweruser}"
duration="${AWS_SESSION_DURATION:-43200}"
saml="${AWS_SAML:-$HOME/.venvs/aws-saml/bin/aws-saml.py}"
force=false

parse_common_args "$@"
for arg in "${rest[@]+"${rest[@]}"}"; do
    case "$arg" in
        --force|-f) force=true ;;
        *) die "unknown option: $arg" "Usage: ${0##*/} [--dry-run] [--force]" ;;
    esac
done

if [ -z "$account" ]; then
    die "no account id" \
        "Set AWS_ACCOUNT to the 12-digit id, or AWS_ACCOUNT_PASS to a pass" \
        "entry whose first line is the id:" \
        "AWS_ACCOUNT=012345678901 ${0##*/}" \
        "AWS_ACCOUNT_PASS=rhat/aws/some-account ${0##*/}"
fi

identity() {
    AWS_PROFILE="$profile" aws sts get-caller-identity \
        --query '[Account,Arn]' --output text 2>/dev/null
}

if [ "$force" = false ]; then
    if current="$(identity)"; then
        # shellcheck disable=SC2086 # two fields, splitting is deliberate
    set -- $current
        if [ "${1:-}" = "$account" ]; then
            echo "Already logged in to $account as ${2:-unknown}"
            echo "Profile '$profile' is still valid. Use --force to renew."
            exit 0
        fi
        echo "Profile '$profile' is valid but for account ${1:-unknown}, renewing..."
    fi
fi

if [ ! -x "$saml" ]; then
    die "aws-saml.py not found at $saml" "Run aws-install-saml first."
fi

if ! klist -s 2>/dev/null; then
    die "no valid Kerberos ticket" \
        "Run: kinit ${KRB_USER:-<your-kerberos-id>}@IPA.REDHAT.COM" \
        "You need the VPN up for that."
fi

mint() {
    "$saml" \
        --target-account "$account" \
        --target-role "$role" \
        --target-profile "$profile" \
        --session-duration "$1"
}

# Everything up to here is read-only, so a dry run rehearses the real
# preconditions: the sts probe, the aws-saml.py path, the Kerberos
# ticket. Minting is the one mutating act -- it consumes a SAML
# assertion and rewrites the profile -- so this is where a dry run
# stops.
if [ "$dry_run" = true ]; then
    info "Would mint credentials for $account as $role (${duration}s),"
    info "writing profile '$profile' via $saml."
    exit 0
fi

# Roles allowed to create an OIDC provider are often left on the AWS
# default of 3600, while poweruser in the same account allows 43200.
# AssumeRoleWithSAML refuses outright rather than quietly shortening, so
# asking for too long is a hard failure. Fall back rather than make you
# rerun by hand with a smaller number.
echo "Minting credentials for $account as $role (${duration}s)..."
if ! mint "$duration"; then
    if [ "$duration" = "3600" ]; then
        die "aws-saml.py failed" \
            "Is the Kerberos ticket valid, the VPN up, and the role real?"
    fi
    warn "Retrying at 3600s, the AWS minimum session duration..."
    mint 3600 || die "aws-saml.py failed at 3600s too" \
        "Is the Kerberos ticket valid, the VPN up, and the role real?"
fi

if ! current="$(identity)"; then
    die "credentials were written but do not work"
fi

# shellcheck disable=SC2086 # two fields, splitting is deliberate
set -- $current
echo
echo "Logged in to $1 as $2"
echo "Use it with: export AWS_PROFILE=$profile"
